<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="nb_night">#0D0B1A</color>

    <!-- Thème de base -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nb_night</item>
        <item name="colorPrimaryDark">@color/nb_night</item>
        <item name="colorAccent">#FF2E93</item>
        <item name="android:windowBackground">@color/nb_night</item>
    </style>

    <!-- Thème du jeu : plein écran, fond sombre, l'image va jusque sous l'encoche -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/nb_night</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Écran de démarrage : fond #0D0B1A (Android 12+ : icône de l'app au centre) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nb_night</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/nb_night</item>
    </style>
</resources>

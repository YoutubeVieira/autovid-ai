  "captions": [
    {
      "from": 0,
      "to": 1.5,
      "text": "Claude vient de"
    },
    {
      "from": 1.5,
      "to": 3,
      "text": "*tuer* le YouTube."
    },
    {
      "from": 3,
      "to": 4.5,
      "text": "Maintenant il fait"
    },
    {
      "from": 4.5,
      "to": 6,
      "text": "le *travail entier* de ta chaîne"
    },
    {
      "from": 6,
      "to": 7,
      "text": "à ta place."
    },
    {
      "from": 7,
      "to": 8.5,
      "text": "Ça s'appelle *YouTube Agent*"
    },
    {
      "from": 8.5,
      "to": 9.5,
      "text": "et c'est *gratuit.*"
    },
    {
      "from": 9.5,
      "to": 11,
      "text": "Et ce n'est pas une skill, c'est *11.*"
    },
    {
      "from": 11,
      "to": 13,
      "text": "Chacune fait un travail différent."
    },
    {
      "from": 13,
      "to": 15,
      "text": "Une écrit tes vidéos"
    },
    {
      "from": 15,
      "to": 17,
      "text": "avec *21* formules de hook qui marchent."
    },
    {
      "from": 17,
      "to": 19,
      "text": "Une écrit tes titres"
    },
    {
      "from": 19,
      "to": 21,
      "text": "et tes miniatures."
    },
    {
      "from": 21,
      "to": 24,
      "text": "Une marque les *coupes* de ta vidéo."
    },
    {
      "from": 24,
      "to": 27,
      "text": "Une gère tes commentaires"
    },
    {
      "from": 27,
      "to": 30,
      "text": "et une planifie ta *semaine* sur YouTube."
    },
    {
      "from": 30,
      "to": 32,
      "text": "Elle t'aide à décider quoi poster,"
    },
    {
      "from": 32,
      "to": 34,
      "text": "*quand* poster et comment."
    },
    {
      "from": 34,
      "to": 36,
      "text": "Elle trouve les vidéos les plus virales"
    },
    {
      "from": 36,
      "to": 38,
      "text": "de ta niche,"
    },
    {
      "from": 38,
      "to": 40,
      "text": "démonte le titre, le hook, la structure et les *recrée* pour toi."
    },
    {
      "from": 40,
      "to": 42,
      "text": "Tu reçois une vidéo virale,"
    },
    {
      "from": 42,
      "to": 43,
      "text": "écrite avec *ta voix.*"
    },
    {
      "from": 43,
      "to": 44.5,
      "text": "Pour l'installer, ouvre *Claude Code*"
    },
    {
      "from": 44.5,
      "to": 46,
      "text": "et colle ce lien."
    }
  ]

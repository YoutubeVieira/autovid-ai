# Clés des services de génération vidéo/voix/musique. Copié en .env (ignoré par git) par installer-styles.
# Ne remplissez que celles des styles que vous utilisez (voir styles/STYLES.md). Ne collez jamais une clé dans le chat.
FAL_KEY=                 # fal.ai : Claymation, Commercial (Seedance 2.0), images, musique avec voix (ElevenLabs Music)
ELEVENLABS_API_KEY=      # voix off Claymation (sinon passe par fal.ai)
ELEVENLABS_VOICE_ID=
KLING_API_KEY=           # OpenMontage : vidéo IA et lip-sync (style Singing)
OPENAI_API_KEY=          # OpenMontage : images / voix (facultatif)
PEXELS_API_KEY=          # OpenMontage : images et vidéos libres (gratuit)
PIXABAY_API_KEY=         # OpenMontage : musique libre (gratuit)
